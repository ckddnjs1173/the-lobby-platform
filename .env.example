# Copy only placeholder names from this file. Never commit real secrets.

# Firebase Web / B2C client - required
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-lobby-platform
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin / server runtime - required
# Production uses these explicit service-account values.
# Local development may instead use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_PROJECT_ID=the-lobby-platform
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AI resume + job-description formatting - required for this release
GROQ_API_KEY=

# Candidate communication - optional for the initial public release.
# Leave all three blank to use manual phone/email contact from the admin workspace.
# When enabling automated email later, configure all three together.
COMMUNICATION_EMAIL_PROVIDER=
RESEND_API_KEY=
COMMUNICATION_FROM_EMAIL=

# Public launch guard.
# Keep false for development/preview. Set true only for the real public production release.
# When true, every public legal/retention value below becomes mandatory and readiness/smoke will fail if incomplete.
PUBLIC_LAUNCH_MODE=false

# Public site identity / legal disclosure.
# Legal service operator is currently fixed in source as the individual operator 박창원.
# Set NEXT_PUBLIC_SITE_URL to the canonical HTTPS public origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CUSTOMER_SUPPORT_CONTACT=

# Concrete retention/deletion policy text shown in the privacy policy.
# Do not use TODO/TBD/미정/확정 필요 placeholders in PUBLIC_LAUNCH_MODE=true.
NEXT_PUBLIC_ACCOUNT_PROFILE_RETENTION=
NEXT_PUBLIC_TALENT_POOL_RETENTION=
NEXT_PUBLIC_APPLICATION_RETENTION=
NEXT_PUBLIC_CONSENT_RETENTION=

# Hosting / infrastructure processing disclosure for the actual production arrangement.
# Fill this from the selected hosting plan/agreement and relevant subprocessors before public launch.
NEXT_PUBLIC_INFRA_PROCESSING_DISCLOSURE=

# Optional: only populate if business registration information actually applies.
NEXT_PUBLIC_BUSINESS_REGISTRATION_INFO=

# Post-deploy smoke test only; do not expose as a browser variable.
PRODUCTION_BASE_URL=https://your-production-domain.example
