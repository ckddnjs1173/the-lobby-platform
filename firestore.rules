rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions: 사용자 인증 및 권한 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isRecruiter() {
      return isAuthenticated() && (getUserData().role == 'RECRUITER' || getUserData().role == 'ADMIN');
    }

    // 1. Candidate (구직자 본체) 규칙 - 본인 또는 권한자만 접근
    match /candidates/{candidateId} {
      allow read: if isAuthenticated() && (resource.data.authUid == request.auth.uid || isRecruiter());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authUid == request.auth.uid || isRecruiter());
      allow delete: if isAdmin();
    }

    // 2. Profile (커리어 정보) 규칙 - 본인 또는 권한자만 접근
    match /profile/{candidateId} {
      allow read: if isAuthenticated() && (request.auth.uid == candidateId || isRecruiter());
      allow create, update: if isAuthenticated() && (request.auth.uid == candidateId || isRecruiter());
      allow delete: if isAdmin();
    }

    // 3. Job (채용 공고) 규칙
    match /jobs/{jobId} {
      allow read: if true; // 누구나 공고 열람 가능
      allow create, update, delete: if isRecruiter();
    }

    // 4. Application (지원 내역) 규칙 - 결정론적 ID 및 위변조 방지
    match /applications/{applicationId} {
      // applicationId가 'candidateId__jobId' 형식이며 본인 혹은 리쿠르터일 때만 읽기 허용
      allow read: if isAuthenticated() && (resource.data.candidateId == request.auth.uid || isRecruiter());
      
      // 생성: 결정론적 ID 포맷 검증 및 권한 확인
      allow create: if isAuthenticated() && 
        applicationId == request.resource.data.candidateId + '__' + request.resource.data.jobId &&
        (request.resource.data.candidateId == request.auth.uid || isRecruiter());

      // 수정: 리쿠르터는 상태 변경 가능 (단, 핵심 키값 불변 보장)
      allow update: if isRecruiter();
      allow delete: if isAdmin();
    }

    // 5. App Event (활동 및 감사 로그) 규칙 - Immutable
    match /appEvents/{eventId} {
      allow read: if isRecruiter();
      // 로그는 인증된 사용자가 생성하되 수정 및 삭제는 절대 불가 (Audit Trail 무결성)
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}