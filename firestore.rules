rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // [ Helper Functions ] - 공통 권한 및 검증 로직
    // =====================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isRecruiter() {
      return isAuthenticated() && 
             (getUserData().role == 'RECRUITER' || getUserData().role == 'ADMIN');
    }

    function hasTenantAccess(orgId) {
      // ADMIN은 모든 테넌트 접근 가능, RECRUITER는 본인 소속 조직(organizationId)만 접근 가능
      return getUserData().role == 'ADMIN' || getUserData().organizationId == orgId;
    }
    
    function isCandidateOwner(candidateId) {
      // Candidate 문서의 authUid가 현재 로그인한 유저의 uid와 일치하는지 교차 검증
      return get(/databases/$(database)/documents/candidates/$(candidateId)).data.authUid == request.auth.uid;
    }

    // =====================================================================
    // [ Collection Rules ] - 도메인별 접근 통제
    // =====================================================================

    // 1. candidates (구직자 본체)
    match /candidates/{candidateId} {
      // 읽기: 본인이거나 시스템 내 리쿠르터
      allow read: if isAuthenticated() && (resource.data.authUid == request.auth.uid || isRecruiter());
      
      // 생성: authUid 필드가 본인의 uid로 정확히 세팅되었을 때만 허용
      allow create: if isAuthenticated() && request.resource.data.authUid == request.auth.uid;
      
      // 수정: 본인이거나 리쿠르터
      allow update: if isAuthenticated() && (resource.data.authUid == request.auth.uid || isRecruiter());
      
      allow delete: if false; // 하드 삭제 엄격 금지 (accountStatus 'INACTIVE' 처리 유도)
    }

    // 2. profile (커리어 정보)
    match /profile/{candidateId} {
      allow read: if isAuthenticated() && (isCandidateOwner(candidateId) || isRecruiter());
      allow create, update: if isAuthenticated() && isCandidateOwner(candidateId);
      allow delete: if false;
    }

    // 3. jobs (채용 공고)
    match /jobs/{jobId} {
      allow read: if true; // 공고 열람은 전체 공개
      
      // 작성/수정: 리쿠르터이면서, 해당 공고에 기입된 조직(organizationId)에 속해야 함
      allow create, update: if isRecruiter() && hasTenantAccess(request.resource.data.organizationId);
      allow delete: if false;
    }

    // 4. applications (지원 내역)
    match /applications/{applicationId} {
      // 읽기: 본인의 지원 내역이거나, 해당 공고를 올린 조직의 리쿠르터만 열람 가능
      allow read: if isAuthenticated() && 
                  (isCandidateOwner(resource.data.candidateId) || 
                  (isRecruiter() && hasTenantAccess(resource.data.organizationId)));
      
      // 생성: 구직자 본인이 직접 지원할 때만 허용 + 결정론적 ID(candidateId__jobId) 서버 검증
      allow create: if isAuthenticated() 
                    && isCandidateOwner(request.resource.data.candidateId)
                    && applicationId == request.resource.data.candidateId + "__" + request.resource.data.jobId;
      
      // 수정: 리쿠르터만 상태 변경 가능. 단, 기존 핵심 키값(후보자, 공고, 조직) 변조는 원천 차단
      allow update: if isRecruiter() 
                    && hasTenantAccess(resource.data.organizationId)
                    && request.resource.data.candidateId == resource.data.candidateId
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.organizationId == resource.data.organizationId;
                    
      allow delete: if false;
    }

    // 5. appEvents (감사 로그 - Audit Trail)
    match /appEvents/{eventId} {
      // 이벤트 로그는 리쿠르터만 열람 가능
      allow read: if isRecruiter();
      
      // 생성: 클라이언트 임의 생성 차단. 이벤트 발생 주체(changedBy)가 실제 로그인한 유저 UID와 일치해야 함.
      allow create: if isAuthenticated() 
                    && request.resource.data.changedBy == request.auth.uid;
                    
      // 수정 및 삭제 절대 불가 (Immutable 특성 강제)
      allow update, delete: if false;
    }
  }
}