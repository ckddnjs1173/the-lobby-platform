rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // Authentication / Authorization helpers
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveB2BUser() {
      return hasUserDocument()
        && currentUserData().status == 'ACTIVE'
        && (
          currentUserData().role == 'ADMIN'
          || currentUserData().role == 'RECRUITER'
        );
    }

    function isAdmin() {
      return isActiveB2BUser()
        && currentUserData().role == 'ADMIN';
    }

    function isRecruiter() {
      return isActiveB2BUser()
        && currentUserData().role == 'RECRUITER';
    }

    function hasTenantAccess(organizationId) {
      return isAdmin()
        || (
          isRecruiter()
          && currentUserData().organizationId == organizationId
        );
    }

    function candidateExists(candidateId) {
      return exists(/databases/$(database)/documents/candidates/$(candidateId));
    }

    function candidateData(candidateId) {
      return get(/databases/$(database)/documents/candidates/$(candidateId)).data;
    }

    function isCandidateOwner(candidateId) {
      return isAuthenticated()
        && candidateExists(candidateId)
        && candidateData(candidateId).authUid == request.auth.uid;
    }

    // ========================================================================
    // Candidate identity / profile
    // ========================================================================

    match /candidates/{candidateId} {
      // Candidate PII may be read only by the linked Firebase account.
      // B2B reads use tenant-authorized Firebase Admin server APIs.
      allow read: if isAuthenticated()
        && resource.data.authUid == request.auth.uid;

      // Registration and profile mutations are server-owned. This is critical:
      // allowing Client SDK writes here would bypass registration consent,
      // server DTO validation, auth-link creation, snapshot synchronization,
      // and audit behavior.
      allow create, update, delete: if false;
    }

    match /profile/{candidateId} {
      allow read: if isCandidateOwner(candidateId);

      // Candidate self-service profile changes also go through
      // /api/candidate/me so server validation and application snapshot sync run.
      allow create, update, delete: if false;
    }

    match /candidateAuthLinks/{authUid} {
      allow read, create, update, delete: if false;
    }

    match /candidateConsents/{candidateId} {
      allow read, create, update, delete: if false;
    }

    // ========================================================================
    // Jobs
    // ========================================================================

    match /jobs/{jobId} {
      // Public job discovery는 Firebase Admin 기반 /api/public/jobs를 사용한다.
      // Raw Job documents contain organizationId, recruiterId and internal
      // employing-company fields, so anonymous Client SDK reads stay disabled.
      allow read: if isActiveB2BUser()
        && hasTenantAccess(resource.data.organizationId);

      allow create, update, delete: if false;
    }

    // ========================================================================
    // Applications
    // ========================================================================

    match /applications/{applicationId} {
      allow read: if isAuthenticated()
        && (
          isCandidateOwner(resource.data.candidateId)
          || (
            isActiveB2BUser()
            && hasTenantAccess(resource.data.organizationId)
          )
        );

      // All application mutations are handled by authenticated server services.
      allow create, update, delete: if false;
    }

    // ========================================================================
    // Server-owned operational collections
    // ========================================================================

    match /appEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /communications/{communicationId} {
      // 수신자, 본문, provider message id와 실패 원인은 서버 소유 데이터다.
      // B2B Communication API가 Firebase Admin으로만 처리한다.
      allow read, create, update, delete: if false;
    }

    match /interviews/{interviewId} {
      allow read, create, update, delete: if false;
    }

    match /talentOpportunities/{opportunityId} {
      allow read, create, update, delete: if false;
    }

    match /publicEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read, create, update, delete: if false;
    }

    match /organizations/{organizationId} {
      allow read, create, update, delete: if false;
    }

    // ========================================================================
    // Default deny
    // ========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
